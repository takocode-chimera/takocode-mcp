{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "takocode": {
      "type": "streamable-http",
      "url": "https://takocode.com/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["takocode", "offline_access"]
          }
        }
      }
    }
  }
}
